<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Symposium 주간 백업(매주 일요일 04:00). 설치:
    cp deploy/com.symposium.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.symposium.backup.plist
  해제: launchctl unload ~/Library/LaunchAgents/com.symposium.backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.symposium.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/broadcastrecord_mac/claudepj/SymposiumProject/scripts/backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/broadcastrecord_mac/claudepj/SymposiumProject</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/broadcastrecord_mac/claudepj/SymposiumProject/logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/broadcastrecord_mac/claudepj/SymposiumProject/logs/backup.error.log</string>
</dict>
</plist>
